// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`CheckoutSummary snapshot > matches the empty-cart state 1`] = `"<div class="sticky top-24 space-y-5"><div class="glass-component p-6 md:p-8"><h2 class="mb-5 text-lg font-semibold tracking-tight text-gray-primary">Order summary</h2><div class="space-y-3 py-10 text-center"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-shopping-bag mx-auto size-10 text-gray-quaternary" aria-hidden="true"><path d="M16 10a4 4 0 0 1-8 0"></path><path d="M3.103 6.034h17.794"></path><path d="M3.4 5.467a2 2 0 0 0-.4 1.2V20a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6.667a2 2 0 0 0-.4-1.2l-2-2.667A2 2 0 0 0 17 2H7a2 2 0 0 0-1.6.8z"></path></svg><p class="font-medium text-gray-tertiary">Your cart is empty</p></div></div></div>"`;

exports[`CheckoutSummary snapshot > matches the nothing-selected state 1`] = `"<div class="sticky top-24 space-y-5"><div class="glass-component p-6 md:p-8"><h2 class="mb-5 text-lg font-semibold tracking-tight text-gray-primary">Order summary</h2><div class="space-y-3 py-10 text-center"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-shopping-bag mx-auto size-10 text-gray-quaternary" aria-hidden="true"><path d="M16 10a4 4 0 0 1-8 0"></path><path d="M3.103 6.034h17.794"></path><path d="M3.4 5.467a2 2 0 0 0-.4 1.2V20a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6.667a2 2 0 0 0-.4-1.2l-2-2.667A2 2 0 0 0 17 2H7a2 2 0 0 0-1.6.8z"></path></svg><p class="font-medium text-gray-tertiary">No items selected</p><a class="inline-block text-sm font-semibold text-gray-secondary underline underline-offset-2 hover:text-gray-primary" href="/cart">Choose items</a></div></div></div>"`;

exports[`CheckoutSummary snapshot > matches the populated order summary 1`] = `"<div class="sticky top-24 space-y-5"><div class="glass-component p-6 md:p-7"><div class="mb-5 flex items-center justify-between gap-3"><h2 class="text-lg font-semibold tracking-tight text-gray-primary">Order summary</h2></div><ul class="custom-scrollbar mb-6 max-h-[360px] space-y-3 overflow-y-auto pr-1"><li class="flex items-start gap-3"><div class="flex size-16 shrink-0 items-center justify-center rounded-xl border border-white/50 bg-white/60 p-1.5"><img alt="" loading="lazy" width="64" height="64" decoding="async" data-nimg="1" class="size-full object-contain" style="color: transparent;" sizes="64px" src="/landing/deck-1.webp"></div><div class="min-w-0 flex-1"><h3 class="mb-0.5 truncate text-sm font-semibold text-gray-primary">Felted wool throw</h3><p class="mb-1 text-xs text-gray-tertiary">Qty: 1</p><span class="text-sm font-semibold tabular-nums text-gray-secondary">$68.00</span></div></li><li class="flex items-start gap-3"><div class="flex size-16 shrink-0 items-center justify-center rounded-xl border border-white/50 bg-white/60 p-1.5"><img alt="" loading="lazy" width="64" height="64" decoding="async" data-nimg="1" class="size-full object-contain" style="color: transparent;" sizes="64px" src="/landing/deck-2.webp"></div><div class="min-w-0 flex-1"><h3 class="mb-0.5 truncate text-sm font-semibold text-gray-primary">Stoneware mug</h3><p class="mb-1 text-xs text-gray-tertiary">Qty: 2</p><span class="text-sm font-semibold tabular-nums text-gray-secondary">$24.00</span></div></li></ul><dl class="mb-6 space-y-2.5 border-t border-gray-primary/10 pt-5 text-sm"><div class="flex justify-between"><dt class="font-medium text-gray-tertiary">Subtotal</dt><dd class="font-semibold tabular-nums text-gray-secondary">$92.00</dd></div><div class="flex justify-between"><dt class="font-medium text-gray-tertiary">Shipping</dt><dd class="font-semibold text-green-600">Free</dd></div><div class="flex justify-between"><dt class="font-medium text-gray-tertiary">Estimated tax</dt><dd class="font-semibold tabular-nums text-gray-secondary">$1.38</dd></div><div class="flex items-center justify-between border-t border-gray-primary/10 pt-3.5"><dt class="text-base font-semibold text-gray-primary">Total</dt><dd class="text-xl font-semibold tabular-nums tracking-tight text-gray-primary">$93.38</dd></div></dl><p class="mt-4 rounded-xl border border-white/50 bg-white/40 px-4 py-3 text-xs leading-relaxed text-gray-tertiary">This total is an estimate. The review step re-quotes your cart from the catalog and Stripe charges that server-quoted total.</p><p class="mt-4 text-center text-xs leading-relaxed text-gray-quaternary">By placing your order, you agree to our <a href="/terms" class="underline underline-offset-2 hover:text-gray-primary">Terms of Service</a> and <a href="/privacy" class="underline underline-offset-2 hover:text-gray-primary">Privacy Policy</a>.</p></div><div class="flex items-center justify-center gap-2 rounded-xl border border-green-600/20 bg-green-500/10 px-4 py-3 text-sm font-semibold text-green-700"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-lock size-4" aria-hidden="true"><rect width="18" height="11" x="3" y="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>Encrypted &amp; secure checkout</div></div>"`;
