# Copy this file to `.env` and fill in real values.
# `.env` is read by Prisma CLI, the seed script, and the test suites; Next.js
# also loads it. Never commit real secrets. Examples below are placeholders.

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
# Optional (public): base URL for Stripe success/cancel redirects.
# Defaults to http://localhost:3000 when unset.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# Database (PostgreSQL)
# ---------------------------------------------------------------------------
# Required: connection string used by the app and Prisma CLI.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ecommerce_dev"

# Test-only: disposable database for the database-backed test suites.
# Required for `npm test`; must differ from DATABASE_URL.
DATABASE_URL_TEST="postgresql://postgres:postgres@localhost:5432/ecommerce_test"

# ---------------------------------------------------------------------------
# Better Auth
# ---------------------------------------------------------------------------
# Required: random session-signing secret (32+ characters).
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET="replace-with-a-random-32-character-secret"
# Required: canonical app base URL (must be a valid URL).
BETTER_AUTH_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# GitHub OAuth
# ---------------------------------------------------------------------------
# Required: GitHub OAuth app credentials.
# Callback URL: <BETTER_AUTH_URL>/api/auth/callback/github
GITHUB_CLIENT_ID="your-github-client-id"
GITHUB_CLIENT_SECRET="your-github-client-secret"

# ---------------------------------------------------------------------------
# Stripe (use test mode locally)
# ---------------------------------------------------------------------------
# Required: server-side secret key.
STRIPE_SECRET_KEY="sk_test_your-secret-key"

# Optional (public): publishable key. Hosted Checkout does not read it today;
# reserved for client-side Stripe.js.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_your-publishable-key"

# Required: webhook signing secret. Locally use the whsec_... printed by
# `stripe listen`; in production use the dashboard endpoint's secret.
STRIPE_WEBHOOK_SECRET="whsec_your-webhook-signing-secret"

# ---------------------------------------------------------------------------
# Cron
# ---------------------------------------------------------------------------
# Required: bearer secret Vercel Cron sends to
# /api/cron/release-reservations. Generate a random value.
CRON_SECRET="replace-with-a-random-cron-secret"
