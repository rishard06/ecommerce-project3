# Copy this file to `.env.local` and fill in real values.
# Never commit real secrets. Example values below are placeholders only.

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# Database (PostgreSQL)
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ecommerce_dev"

# ---------------------------------------------------------------------------
# Better Auth
# ---------------------------------------------------------------------------
BETTER_AUTH_SECRET="replace-with-a-random-32-character-secret"
BETTER_AUTH_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# GitHub OAuth
# ---------------------------------------------------------------------------
GITHUB_CLIENT_ID="your-github-client-id"
GITHUB_CLIENT_SECRET="your-github-client-secret"

# ---------------------------------------------------------------------------
# Stripe (test mode)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_your-publishable-key"
STRIPE_SECRET_KEY="sk_test_your-secret-key"

# Required: Stripe webhook signing secret (used to verify webhook payloads).
STRIPE_WEBHOOK_SECRET="whsec_your-webhook-signing-secret"

# Required: shared bearer secret that authenticates the Vercel Cron cleanup route.
CRON_SECRET="replace-with-a-random-cron-secret"
