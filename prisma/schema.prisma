// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  ADMIN
}

model User {
  id            String    @id
  name          String
  email         String
  emailVerified Boolean
  image         String?
  createdAt     DateTime
  updatedAt     DateTime
  role          Role      @default(CUSTOMER)
  sessions      Session[]
  accounts      Account[]
  addresses     Address[]
  reviews       Review[]
  orders        Order[]

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime
  updatedAt DateTime
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime
  updatedAt             DateTime

  @@map("account")
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime?
  updatedAt  DateTime?

  @@map("verification")
}

enum OrderStatus {
  PENDING
  PAID
  CANCELLED
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  CANCELLED
  REFUNDED
}

enum FulfillmentStatus {
  UNFULFILLED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum ReservationStatus {
  ACTIVE
  COMMITTED
  RELEASED
}

/**
 * Customer return lifecycle (Task 14 owns this shape; Task 15 consumes it).
 * One row per order: `orderId` is unique so a second request for the same
 * order is rejected at the database level. `reason` is a short free-text
 * explanation from the customer. `status` starts `PENDING`; the admin
 * approve path (Task 15) moves it to `APPROVED` (refund issued) or `REJECTED`
 * (declined, no money moved), and must check the status before refunding so a
 * double-approve never triggers a second Stripe refund.
 */
enum ReturnStatus {
  PENDING
  APPROVED
  REJECTED
}

model ReturnRequest {
  id        String       @id @default(uuid())
  orderId   String       @unique
  order     Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  reason    String
  status    ReturnStatus @default(PENDING)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
}

model Order {
  id                String            @id @default(uuid())
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  userId            String?
  user              User?             @relation(fields: [userId], references: [id], onDelete: Restrict)
  guestToken        String?           @unique
  status            OrderStatus       @default(PENDING)
  fulfillmentStatus FulfillmentStatus @default(UNFULFILLED)
  currency          String            @default("USD")

  // Integer-cent money snapshot. Never floats.
  subtotalCents Int
  shippingCents Int @default(0)
  taxCents      Int
  totalCents    Int

  // Coupon snapshot captured at order creation (Task 9 owns this shape;
  // Task 10 computes it). Never floats: integer cents.
  discountCents Int     @default(0)
  couponCode    String?

  // Scalar shipping snapshot captured at order creation.
  shippingFullName   String
  shippingLine1      String
  shippingLine2      String?
  shippingCity       String
  shippingRegion     String
  shippingPostalCode String
  shippingCountry    String

  idempotencyKey String?

  items         OrderItem[]
  payment       Payment?
  reservations  Reservation[]
  auditLogs     OrderAuditLog[]
  returnRequest ReturnRequest?

  @@unique([userId, idempotencyKey])
  @@unique([guestToken, idempotencyKey])
  @@index([userId, createdAt])
}

model Coupon {
  id String @id @default(uuid())

  // Uppercase code (e.g. "SAVE10"). Normalized to uppercase on read/write.
  code String @unique

  // Exactly one discount leg is set. Percent is a whole number 1-100;
  // fixed amounts are integer cents. Never floats.
  percentOff     Int?
  amountOffCents Int?

  minSubtotalCents Int       @default(0)
  expiresAt        DateTime?
  maxUses          Int?
  usedCount        Int       @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model OrderItem {
  id             String          @id @default(uuid())
  order          Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId        String
  variantId      String?
  variant        ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  productSlug    String
  sku            String
  title          String
  unitPriceCents Int
  quantity       Int
  lineTotalCents Int

  @@index([orderId])
}

model Payment {
  id                      String        @id @default(uuid())
  orderId                 String        @unique
  order                   Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  provider                String        @default("stripe")
  providerSessionId       String?       @unique
  providerPaymentIntentId String?       @unique
  status                  PaymentStatus @default(PENDING)
  amountCents             Int
  currency                String        @default("USD")
  createdAt               DateTime      @default(now())
  updatedAt               DateTime      @updatedAt
}

model Reservation {
  id        String            @id @default(uuid())
  orderId   String
  order     Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variantId String
  variant   ProductVariant    @relation(fields: [variantId], references: [id], onDelete: Restrict)
  quantity  Int
  status    ReservationStatus @default(ACTIVE)
  expiresAt DateTime
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  @@index([orderId])
  @@index([status, expiresAt])
}

model WebhookEvent {
  id              String    @id @default(uuid())
  provider        String    @default("stripe")
  providerEventId String    @unique
  type            String
  payload         Json
  processedAt     DateTime?
  createdAt       DateTime  @default(now())
}

model OrderAuditLog {
  id         String   @id @default(uuid())
  orderId    String
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  actorId    String?
  action     String
  fromStatus String?
  toStatus   String?
  createdAt  DateTime @default(now())

  @@index([orderId, createdAt])
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

model Category {
  id        String    @id @default(uuid())
  slug      String    @unique
  name      String
  products  Product[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@map("category")
}

model Product {
  id          String           @id @default(uuid())
  slug        String           @unique
  title       String
  description String
  brand       String?
  status      ProductStatus    @default(DRAFT)
  categoryId  String
  category    Category         @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  images      ProductImage[]
  variants    ProductVariant[]
  /// Aggregate DummyJSON rating (0–5) carried into the owned catalog.
  rating      Float            @default(0)
  /// Raw seed reviews: [{ rating, comment, date, reviewerName }].
  reviews     Json?
  /// Signed-in customer reviews stored in the owned catalog.
  userReviews Review[]
  /// Non-empty policy strings: [warrantyInformation, shippingInformation, returnPolicy].
  features    String[]         @default([])
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([categoryId, status])
  @@map("product")
}

model ProductImage {
  id        String  @id @default(uuid())
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String
  url       String
  position  Int

  @@unique([productId, position])
  @@map("product_image")
}

model ProductVariant {
  id           String        @id @default(uuid())
  product      Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId    String
  sku          String        @unique
  name         String        @default("Default")
  priceCents   Int
  currency     String        @default("USD")
  onHand       Int           @default(0)
  reserved     Int           @default(0)
  isDefault    Boolean       @default(true)
  orderItems   OrderItem[]
  reservations Reservation[]

  @@index([productId])
  @@map("product_variant")
}

model Address {
  id         String  @id @default(uuid())
  userId     String
  user       User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName   String
  line1      String
  line2      String?
  city       String
  region     String
  postalCode String
  country    String
  isDefault  Boolean @default(false)

  @@index([userId])
  @@map("address")
}

model Review {
  id          String   @id @default(uuid())
  productSlug String
  product     Product  @relation(fields: [productSlug], references: [slug], onDelete: Cascade)
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  rating      Int
  comment     String
  createdAt   DateTime @default(now())

  @@unique([productSlug, userId])
  @@index([productSlug, createdAt])
  @@map("review")
}
