// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  ADMIN
}

model User {
  id            String    @id
  name          String
  email         String
  emailVerified Boolean
  image         String?
  createdAt     DateTime
  updatedAt     DateTime
  role          Role      @default(CUSTOMER)
  sessions      Session[]
  accounts      Account[]
  orders        Order[]

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime
  updatedAt DateTime
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime
  updatedAt             DateTime

  @@map("account")
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime?
  updatedAt  DateTime?

  @@map("verification")
}

enum OrderStatus {
  PENDING
  PAID
  CANCELLED
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  CANCELLED
}

enum FulfillmentStatus {
  UNFULFILLED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum ReservationStatus {
  ACTIVE
  COMMITTED
  RELEASED
}

model Order {
  id                String            @id @default(uuid())
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  userId            String
  user              User              @relation(fields: [userId], references: [id], onDelete: Restrict)
  status            OrderStatus       @default(PENDING)
  fulfillmentStatus FulfillmentStatus @default(UNFULFILLED)
  currency          String            @default("USD")

  // Integer-cent money snapshot. Never floats.
  subtotalCents Int
  shippingCents Int @default(0)
  taxCents      Int
  totalCents    Int

  // Scalar shipping snapshot captured at order creation.
  shippingFullName   String
  shippingLine1      String
  shippingLine2      String?
  shippingCity       String
  shippingRegion     String
  shippingPostalCode String
  shippingCountry    String

  idempotencyKey String?

  items        OrderItem[]
  payment      Payment?
  reservations Reservation[]
  auditLogs    OrderAuditLog[]

  @@unique([userId, idempotencyKey])
  @@index([userId, createdAt])
}

model OrderItem {
  id             String          @id @default(uuid())
  order          Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId        String
  variantId      String?
  variant        ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  productSlug    String
  sku            String
  title          String
  unitPriceCents Int
  quantity       Int
  lineTotalCents Int

  @@index([orderId])
}

model Payment {
  id                      String        @id @default(uuid())
  orderId                 String        @unique
  order                   Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  provider                String        @default("stripe")
  providerSessionId       String?       @unique
  providerPaymentIntentId String?       @unique
  status                  PaymentStatus @default(PENDING)
  amountCents             Int
  currency                String        @default("USD")
  createdAt               DateTime      @default(now())
  updatedAt               DateTime      @updatedAt
}

model Reservation {
  id        String            @id @default(uuid())
  orderId   String
  order     Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variantId String
  variant   ProductVariant    @relation(fields: [variantId], references: [id], onDelete: Restrict)
  quantity  Int
  status    ReservationStatus @default(ACTIVE)
  expiresAt DateTime
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  @@index([orderId])
  @@index([status, expiresAt])
}

model WebhookEvent {
  id              String    @id @default(uuid())
  provider        String    @default("stripe")
  providerEventId String    @unique
  type            String
  payload         Json
  processedAt     DateTime?
  createdAt       DateTime  @default(now())
}

model OrderAuditLog {
  id         String   @id @default(uuid())
  orderId    String
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  actorId    String?
  action     String
  fromStatus String?
  toStatus   String?
  createdAt  DateTime @default(now())

  @@index([orderId, createdAt])
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

model Category {
  id        String    @id @default(uuid())
  slug      String    @unique
  name      String
  products  Product[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@map("category")
}

model Product {
  id          String           @id @default(uuid())
  slug        String           @unique
  title       String
  description String
  brand       String?
  status      ProductStatus    @default(DRAFT)
  categoryId  String
  category    Category         @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  images      ProductImage[]
  variants    ProductVariant[]
  /// Aggregate DummyJSON rating (0–5) carried into the owned catalog.
  rating      Float            @default(0)
  /// Raw seed reviews: [{ rating, comment, date, reviewerName }].
  reviews     Json?
  /// Non-empty policy strings: [warrantyInformation, shippingInformation, returnPolicy].
  features    String[]         @default([])
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([categoryId, status])
  @@map("product")
}

model ProductImage {
  id        String  @id @default(uuid())
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String
  url       String
  position  Int

  @@unique([productId, position])
  @@map("product_image")
}

model ProductVariant {
  id           String        @id @default(uuid())
  product      Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId    String
  sku          String        @unique
  name         String        @default("Default")
  priceCents   Int
  currency     String        @default("USD")
  onHand       Int           @default(0)
  reserved     Int           @default(0)
  isDefault    Boolean       @default(true)
  orderItems   OrderItem[]
  reservations Reservation[]

  @@index([productId])
  @@map("product_variant")
}
